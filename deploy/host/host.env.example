# Settings of the tenant host (#92). Copy to host.env and keep it readable by you only (chmod 600).
# Plain KEY=value lines, as Docker reads them: the value runs to the end of the line, without quotes.

# --- Tenant addresses. {tenant} is replaced by the tenant's short name.
# --- The default is one level under the domain, which Cloudflare's free certificate covers.
# --- A deeper pattern ({tenant}.mcpaudit.example.com) needs Cloudflare's advanced certificate.
TENANT_ADDRESS_PATTERN=mcpaudit-{tenant}.example.com

# --- Where the tenants' directories live on this server.
TENANTS_DIR=/srv/mcp-audit/tenants

# --- Which image tenants run: main, a version such as v0.3.0, or latest.
MCP_AUDIT_TAG=main

# --- The network the tunnel and the proxy share. Only requests from it may name the visitor's address.
# EDGE_SUBNET=172.31.250.0/24
# --- Where a tunnel that runs on the server itself reaches the proxy (this machine only).
# PROXY_PORT=8088

# --- The library sources a new tenant starts with (codes of the sources that ship with the app).
TENANT_SOURCES=nis2

# --- Email for the tenants' instances: your one SMTP account, written into each tenant's own
# --- environment file. {title} in the sender is replaced by the tenant's title.
TENANT_SMTP_HOST=
TENANT_SMTP_PORT=587
TENANT_SMTP_USER=
TENANT_SMTP_PASSWORD=
TENANT_SMTP_FROM={title} <audit@example.com>

# --- Cloudflare. The API token needs one permission: Zone, DNS, Edit, on this one zone.
# --- It adds and removes the tenants' DNS records and nothing else.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# --- The tunnel the tenants' names point at (the id in <id>.cfargotunnel.com).
CLOUDFLARE_TUNNEL_ID=
# --- Only when the tunnel runs from this Compose file (--profile tunnel).
# CLOUDFLARE_TUNNEL_TOKEN=

# --- Limits per tenant container.
# TENANT_MEMORY=768m
# TENANT_CPUS=1.0
