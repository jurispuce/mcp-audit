# One tenant's settings (#92). Lives as .env in the tenant's directory, readable by the operator
# only (chmod 600). No value here is shared with another tenant.

# --- Who this is. TENANT is the short name ([a-z0-9-]); TENANT_HOST the address without https://.
TENANT=acme
TENANT_HOST=mcpaudit-acme.example.com
MCP_AUDIT_TAG=main

# --- This tenant's own passphrase for backups (at least 12 characters).
BACKUP_PASSPHRASE=

# --- Email: the operator's SMTP account, the same for every tenant; the sender names the tenant.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Limits for this tenant's container, when they differ from the host's.
# TENANT_MEMORY=768m
# TENANT_CPUS=1.0

TZ=Europe/Riga
