# Copy to .env and adjust. Every setting is optional unless marked required.

# --- Network
# Address on the host the port is published on. 127.0.0.1 = this machine only.
# Use a LAN or VPN address (for example a Tailscale IP) to share with the team.
BIND_ADDRESS=127.0.0.1
# Port on the host.
HOST_PORT=3000
# Public URL people use to reach the app, for example https://audit.example.lan
# Leave empty to accept any host name or IP: the protocol is then taken from X-Forwarded-Proto
# (set by a TLS proxy) and is http when the header is absent.
ORIGIN=
# Behind a reverse proxy, you may name the headers to trust instead:
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# --- Image
# Which published image tag to run: latest, main, or a version such as v0.1.0
MCP_AUDIT_TAG=latest

# --- Storage (inside the container; the Compose file mounts the volume here)
DATA_DIR=/data

# --- First admin (optional). Without these, open /setup and enter the code from the log.
# INITIAL_ADMIN_EMAIL=you@example.com
# INITIAL_ADMIN_PASSWORD=at-least-10-characters
# INITIAL_ADMIN_NAME=Your Name

# --- Backups (see docs/backup.md). At least 12 characters; keep a copy outside the server.
BACKUP_PASSPHRASE=

# --- Time zone for log timestamps and report dates
TZ=Europe/Riga

# --- Testing only. Never set in production.
# Enables the seed command and the test login used by end-to-end tests.
TEST_SEED_ENABLED=false
