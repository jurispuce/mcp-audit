{
	"name": "mcp-audit",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Audit planning and running app: versioned audit database, responsive UI, MCP server and audit skills.",
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node server.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''; [ -f scripts/install-hooks.mjs ] && node scripts/install-hooks.mjs || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"verify": "npm run format:check && npm run lint && npm run check && npm run test",
		"seed": "node scripts/seed.mjs",
		"e2e": "playwright test --config=e2e/playwright.config.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.19.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"lint-staged": "^17.6.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"better-sqlite3": "^13.1.1",
		"drizzle-orm": "^0.45.4",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"lint-staged": {
		"*.{ts,js,mjs,svelte}": [
			"prettier --write",
			"eslint --fix --no-warn-ignored"
		],
		"*.{json,md,css,html,yml,yaml}": "prettier --write"
	}
}
